# Copy to .env and customise. Docker Compose reads .env automatically.
# The values below are INSECURE local-development defaults. Override every one
# before any shared or internet-facing deployment, and set APP_ENV=production
# so the backends refuse to start with a weak/unset ADMIN_KEY.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ADMIN_KEY=dev-admin-key

# Set to "production" to enforce credential checks at startup.
APP_ENV=development

# Optional NATS auth: path to a JWT/nkey credentials file mounted into the
# backends. User/password and TLS can instead be carried by NATS_URL
# (nats://user:pass@host, tls://host).
# NATS_CREDS=/run/secrets/nats.creds
